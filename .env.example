# Copie para .env e preencha os valores. Nunca commite .env.

# OpenAI (obrigatório para embeddings e LLM)
OPENAI_API_KEY=

# Langfuse (monitoramento LLMOps - drift, tokens, latência)
# Obtenha em https://cloud.langfuse.com ou use self-hosted
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Opcional: self-hosted
# LANGFUSE_HOST=https://your-langfuse-host

# Ambiente
ENVIRONMENT=development
