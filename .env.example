# Copie para .env e preencha os valores. Nunca commite .env.

# OpenAI (obrigatório para embeddings e LLM)
OPENAI_API_KEY=

# Langfuse (monitoramento LLMOps - drift, tokens, latência)
# Obtenha em https://cloud.langfuse.com ou use self-hosted
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Opcional: self-hosted
# LANGFUSE_HOST=https://your-langfuse-host

# Ambiente
ENVIRONMENT=development

# RAG opcionais (default: false). Aumentam recall/custo/latência.
# RAG_QUERY_EXPANSION=true   # Expande pergunta em 2-3 variantes antes do retrieval
# RAG_CONTEXT_COMPRESSION=true  # Comprime chunks com LLM (LLMChainExtractor)
# RAG_USE_HYDE=true          # Índice com perguntas hipotéticas; requer treino com --hyde
# RAG_QUERY_EXPANSION_N=3    # Número de variantes (default 3)
# RAG_HYDE_QUESTIONS_PER_CHUNK=2  # Perguntas por chunk no treino HyDE (default 2)
