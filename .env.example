# Copie para .env e preencha os valores. Nunca commite .env.

# OpenAI (obrigatório para embeddings e LLM)
OPENAI_API_KEY=

# Langfuse (monitoramento LLMOps - drift, tokens, latência)
# Obtenha em https://cloud.langfuse.com ou use self-hosted (Setup Tracing ou Project Settings).
# Obrigatório para métricas: sem PUBLIC_KEY e SECRET_KEY nenhum trace é enviado e o status fica "pending".
# Após preencher, reinicie a API: docker-compose restart api (ou up -d). Depois faça um POST /predict e veja Traces no Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted ou Docker: use http://langfuse-server:3000; cloud deixe vazio.
# O app mapeia LANGFUSE_HOST para LANGFUSE_BASE_URL (SDK Langfuse 2.x). Ou defina LANGFUSE_BASE_URL diretamente.
LANGFUSE_HOST=

# ChromaDB (Docker: use chromadb para conectar ao serviço; local vazio = persist em app/model/chroma_db)
CHROMA_HOST=

# Ambiente
ENVIRONMENT=development

# RAG opcionais (default: false). Aumentam recall/custo/latência.
# RAG_QUERY_EXPANSION=true   # Expande pergunta em 2-3 variantes antes do retrieval
# RAG_CONTEXT_COMPRESSION=true  # Comprime chunks com LLM (LLMChainExtractor)
# RAG_USE_HYDE=true          # Índice com perguntas hipotéticas; requer treino com --hyde
# RAG_QUERY_EXPANSION_N=3    # Número de variantes (default 3)
# RAG_HYDE_QUESTIONS_PER_CHUNK=2  # Perguntas por chunk no treino HyDE (default 2)

# Referência para quem sobe só o Langfuse (docker-compose): DATABASE_URL no langfuse-server
# DATABASE_URL=postgresql://postgres:postgres@langfuse-db:5432/langfuse
